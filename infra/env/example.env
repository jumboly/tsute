# 環境ごとの非秘密設定の例。`cp infra/env/example.env infra/env/<env>.env` して編集する。
# infra/env/<env>.env は .gitignore 済み（環境固有の値をリポジトリに入れないため）。
# CI では同名の GitHub Actions Variables から与える。

# バックエンド（Lambda/DynamoDB/S3/API Gateway）のリージョン
AWS_REGION=ap-northeast-1
# 任意: 利用する AWS CLI プロファイル
# AWS_PROFILE=
# 任意: カスタムドメイン（APP_BASE_URL のホスト部）。空なら *.cloudfront.net を使う
TSUTE_APP_DOMAIN=
# 任意: TSUTE_APP_DOMAIN 用の us-east-1 の ACM 証明書 ARN（infra/request-cert.sh で発行）
TSUTE_CERT_ARN=
# 任意: Blog リポジトリ。設定すると Blog 用デプロイロールを作る（Environment production のジョブだけが引き受け可能）。
# OIDC の immutable subject が有効なら owner@ownerId/repo@repoId 形式
# （gh api repos/<owner>/<repo>/actions/oidc/customization/sub の sub_claim_prefix から repo: を除いた値）
TSUTE_GITHUB_BLOG_REPO=
